# MongoDB Atlas Connection URI
# Replace with your actual connection string in your local .env file
# Format: mongodb+srv://<username>:<password>@<cluster-url>/nyaysetu?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/nyaysetu?retryWrites=true&w=majority

# Port for future Express server (optional)
PORT=5000
